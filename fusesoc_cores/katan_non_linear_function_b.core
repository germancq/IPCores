CAPI=2:

name : ::katan_non_linear_function_b:0
description : katan non linear function b 

targets:
  default:
    filesets: 
      - rtl

  sim : 
    flow : sim
    flow_options :
      tool : verilator 
      verilator_options : [-Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-SELRANGE]
      cocotb_module : katan_non_linear_function_b_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl ,cocotb]  
    toplevel : non_linear_function_b
    parameters :
      - L2_LEN=19

parameters :
  L2_LEN :
    datatype : int
    paramtype : vlogparam

filesets:
  cocotb :
    files :
      - block_ciphers/KATAN/cocotb_files/katan_non_linear_function_b_test.py : {file_type : user, copyto : .}
      - block_ciphers/KATAN/python_code/katan.py : {file_type : user, copyto : .}
      - block_ciphers/KATAN/python_code/LFSR.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils


  rtl:
    file_type: systemVerilogSource
    files: 
      - block_ciphers/KATAN/hdl_code/non_linear_function_b.sv      

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master






