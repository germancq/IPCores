CAPI=2:


name : ::kdf_spongent_system_cocotb:0 
description : KDF_spongent core, testing in cococtb and in a complete system for hardware

filesets :
  cocotb :
    files :
      - KDF/KDF_spongent/cocotb_files/KDF_spongent_test_docker.py : {file_type : user, copyto : .}
      - KDF/KDF_spongent/python_code/keyDerivationFunction.py : {file_type : user, copyto : .}
      - hash_functions/spongent/python_code/spongent.py : {file_type : user, copyto : .}
      - hash_functions/spongent/python_code/LFSR.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils
  rtl_KDF_spongent :
    depend :
      - KDF_spongent
      - register 
      - counter
      - mux
      - memory_module

  rtl_top :

    depend :
      - sdspi
      - seven_segments

    file_type : systemVerilogSource

    files :
      - KDF/KDF_spongent/Hardware_verfication_files/fusesoc_files/rtl/top.sv


  rtl_autotest :
    file_type : systemVerilogSource
    files : 
      - KDF/KDF_spongent/Hardware_verfication_files/fusesoc_files/rtl/autotest_module/autotest_module.sv
      - KDF/KDF_spongent/Hardware_verfication_files/fusesoc_files/rtl/autotest_module/control_unit_detailed.sv

  constraints : 
    file_type : xdc
    files :
      - KDF/KDF_spongent/Hardware_verfication_files/fusesoc_files/data/Nexys4DDR_Master.xdc

targets :

  sim : 
    flow : sim
    flow_options :
      tool : icarus
      iverilog_options : [-g2012]
      cocotb_module : KDF_spongent_test_docker
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl_KDF_spongent ,cocotb]  
    toplevel : KDF_spongent 
    parameters :
      - N=88
      - c=80
      - r=8
      - R=45
      - lCounter_initial_state=0x05
      - lCounter_feedback_coeff=0x61
      - SALT_WIDTH=64
      - COUNT_WIDTH=32
      - PSW_WIDTH=80

parameters :
  N :
    datatype : int
    paramtype : vlogparam
  c :
    datatype : int
    paramtype : vlogparam
  r :
    datatype : int
    paramtype : vlogparam
  R :
    datatype : int
    paramtype : vlogparam
  lCounter_initial_state :
    datatype : int
    paramtype : vlogparam
  lCounter_feedback_coeff :
    datatype : int
    paramtype : vlogparam
  SALT_WIDTH :
    datatype : int
    paramtype : vlogparam
  COUNT_WIDTH :
    datatype : int
    paramtype : vlogparam
  PSW_WIDTH :
    datatype : int
    paramtype : vlogparam

provider :
  name : github
  user : germancq
  repo : IPCores
  version : master


