CAPI=2:

name : ::speck_wb:0
description : speck block cipher with wishbone interface

targets:
   default: &default
     filesets:
       - rtl


parameters :
  M :
    datatype : int
    paramtype : vlogparam
  N :
    datatype : int
    paramtype : vlogparam
  WB_DATA_WIDTH :
    datatype : int
    paramtype : vlogparam
  WB_ADDR_DIR :
    datatype : int
    paramtype : vlogparam
  OFFSET_ADDR :
    datatype : int
    paramtype : vlogparam

filesets:

   rtl:
     file_type: systemVerilogSource
     files:
       - block_ciphers/SPECK/hdl_code/speck_wb.sv
     depend:
       - block_cipher_wb_bridge
       - speck


provider:
    name: github
    user: germancq
    repo: IPCores
    version: master

