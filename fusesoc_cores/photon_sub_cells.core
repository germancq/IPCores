CAPI=2:

name : ::photon_sub_cells:0
description : photon sub_cells function

targets:
  default:
    filesets: 
      - rtl

  sim : 
    flow : sim
    flow_options :
      tool : verilator 
      verilator_options : [-Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-SELRANGE]
      cocotb_module : sub_cells_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl ,cocotb]  
    toplevel : sub_cells
    parameters :
      - BIT_CELL=4
      - DIM=5

parameters :
  BIT_CELL :
    datatype : int
    paramtype : vlogparam
  DIM :
    datatype : int
    paramtype : vlogparam

filesets:
  cocotb :
    files :
      - hash_functions/photon/cocotb_files/sub_cells_test.py : {file_type : user, copyto : .}
      - hash_functions/photon/python_code/photon.py : {file_type : user, copyto : .}
      - hash_functions/photon/python_code/galois_arithmetic.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils


  rtl:
    file_type: systemVerilogSource
    files: 
      - hash_functions/photon/hdl_code/sub_cells.sv      
    depend:
      - photon_sbox

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master








