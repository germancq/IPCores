CAPI=2:

name : ::tea_wb:0
description : TEA block cipher with wishbone interface

targets:
   default: &default
     filesets:
       - rtl


parameters :
  KEY_LEN :
    datatype : int
    paramtype : vlogparam
  BLK_LEN :
    datatype : int
    paramtype : vlogparam
  WB_DATA_WIDTH :
    datatype : int
    paramtype : vlogparam
  WB_ADDR_DIR :
    datatype : int
    paramtype : vlogparam
  OFFSET_ADDR :
    datatype : int
    paramtype : vlogparam

filesets:

   rtl:
     file_type: systemVerilogSource
     files:
       - block_ciphers/TEA/hdl_code/tea_wb.sv
     depend:
       - tea
       - block_cipher_wb_bridge


provider:
    name: github
    user: germancq
    repo: IPCores
    version: master
