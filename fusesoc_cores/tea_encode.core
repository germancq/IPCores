CAPI=2:

name : ::tea_encode:0
description : tea encrypt function

targets:
  default:
    filesets: 
      - rtl

  sim : 
    flow : sim
    flow_options :
      tool : verilator 
      verilator_options : [-Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-SELRANGE]
      cocotb_module : encode_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl ,cocotb]  
    toplevel : encode


filesets:
  cocotb :
    files :
      - block_ciphers/TEA/cocotb_files/encode_test.py : {file_type : user, copyto : .}
      - block_ciphers/TEA/python_code/tea.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils


  rtl:
    file_type: systemVerilogSource
    files: 
      - block_ciphers/TEA/hdl_code/encode.sv      
    depend:
      - counter 
      - register

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master








