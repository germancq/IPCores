CAPI=2:

name : ::hirose_present:0
description : hirose hash with present block cipher

targets:
    default:
        filesets: 
            - rtl



filesets:
    rtl:
        file_type: systemVerilogSource
        files: 
   	    - hash_functions/hirose_present/hdl_code/hirose_present_wrapper.sv
  	    - hash_functions/hirose_present/hdl_code/hirose_present.sv
            
        depend:
            - counter
            - present_cipher
            - memory_module
            - register

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master
