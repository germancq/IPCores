CAPI=2:


name : ::spongent_iter_system_cocotb:0 
description : spongent_iter core, testing in cococtb and in a complete system for hardware

filesets :
  cocotb :
    files :
      - hash_functions/spongent_iter/cocotb_files/spongent_iter_test_docker.py : {file_type : user, copyto : .}
      - hash_functions/spongent_iter/python_code/spongent_iter.py : {file_type : user, copyto : .}
      - hash_functions/spongent_iter/python_code/LFSR.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils
  rtl_spongent_iter :
    depend :
      - spongent_iter_hash
      - register 
      - counter
      - mux
      - memory_module

  rtl_top :

    depend :
      - sdspi
      - seven_segments

    file_type : systemVerilogSource

    files :
      - hash_functions/spongent_iter/Hardware_verfication_files/fusesoc_files/rtl/top.sv


  rtl_autotest :
    file_type : systemVerilogSource
    files : 
      - hash_functions/spongent_iter/Hardware_verfication_files/fusesoc_files/rtl/autotest_module/autotest_module.sv
      - hash_functions/spongent_iter/Hardware_verfication_files/fusesoc_files/rtl/autotest_module/control_unit_detailed.sv

  constraints : 
    file_type : xdc
    files :
      - hash_functions/spongent_iter/Hardware_verfication_files/fusesoc_files/data/Nexys4DDR_Master.xdc

targets :

  sim : 
    flow : sim
    flow_options :
      tool : icarus
      iverilog_options : [-g2012]
      cocotb_module : spongent_iter_test_docker
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl_spongent_iter ,cocotb]  
    toplevel : spongent_iter 
    parameters :
      - N=256
      - c=256
      - r=16
      - R=140
      - lCounter_initial_state=0x9E
      - lCounter_feedback_coeff=0x11D

parameters :
  N :
    datatype : int
    paramtype : vlogparam
  c :
    datatype : int
    paramtype : vlogparam
  r :
    datatype : int
    paramtype : vlogparam
  R :
    datatype : int
    paramtype : vlogparam
  lCounter_initial_state :
    datatype : int
    paramtype : vlogparam
  lCounter_feedback_coeff :
    datatype : int
    paramtype : vlogparam

provider :
  name : github
  user : germancq
  repo : IPCores
  version : master


