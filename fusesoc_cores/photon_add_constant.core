CAPI=2:

name : ::photon_add_constant:0
description : photon add_constant function

targets:
  default:
    filesets: 
      - rtl

  sim : 
    flow : sim
    flow_options :
      tool : verilator 
      verilator_options : [-Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-SELRANGE]
      cocotb_module : add_constant_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl ,cocotb]  
    toplevel : add_constant
    parameters :
      - BIT_CELL=4
      - T_SIZE=100
      - DIM=5

parameters :
  BIT_CELL :
    datatype : int
    paramtype : vlogparam
  T_SIZE :
    datatype : int
    paramtype : vlogparam
  DIM :
    datatype : int
    paramtype : vlogparam

filesets:
  cocotb :
    files :
      - hash_functions/photon/cocotb_files/add_constant_test.py : {file_type : user, copyto : .}
      - hash_functions/photon/python_code/photon.py : {file_type : user, copyto : .}
      - hash_functions/photon/python_code/galois_arithmetic.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils


  rtl:
    file_type: systemVerilogSource
    files: 
      - hash_functions/photon/hdl_code/add_constant.sv      
    depend:
      - photon_rc
      - photon_ic

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master







