
CAPI=2:


name : ::lea_system_cocotb:0 
description : Lea core, testing in cococtb and in a complete system for hardware

filesets :
  cocotb :
    files :
      - block_ciphers/LEA/cocotb_files/lea_test_docker.py : {file_type : user, copyto : .}
      - block_ciphers/LEA/python_code/LEA.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils
  rtl_lea :
    depend :
      - LEA
      - register 
      - counter
      - mux
      - memory_module

  rtl_top :

    depend :
      - sdspi
      - seven_segments

    file_type : systemVerilogSource

    files :
      - block_ciphers/LEA/Hardware_verfication_files/fusesoc_files/rtl/top.sv


  rtl_autotest :
    file_type : systemVerilogSource
    files : 
      - block_ciphers/LEA/Hardware_verfication_files/fusesoc_files/rtl/autotest_module/autotest_module.sv
      - block_ciphers/LEA/Hardware_verfication_files/fusesoc_files/rtl/autotest_module/control_unit_detailed.sv

  constraints : 
    file_type : xdc
    files :
      - block_ciphers/LEA/Hardware_verfication_files/fusesoc_files/data/Nexys4DDR_Master.xdc

targets :

  sim : 
    flow : sim
    flow_options :
      tool : icarus
      iverilog_options : [-g2012]
      cocotb_module : lea_test_docker
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl_lea ,cocotb]  
    toplevel : LEA 
provider :
  name : github
  user : germancq
  repo : IPCores
  version : master
