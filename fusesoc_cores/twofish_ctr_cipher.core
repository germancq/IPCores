CAPI=2:

name : ::twofish_ctr_cipher:0
description : twofish block cipher in ctr mode

targets:
    default:
        filesets: 
            - rtl



filesets:
    rtl:
        file_type: systemVerilogSource
        files: 
            - block_ciphers/twofish_cipher_ctr/hdl_code/twofish_ctr.sv
            
        depend:
            - counter
            - adder
            - galois_arithmetic
            - register

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master
