CAPI=2:

name : ::speck_key_schedule:0
description : speck key_schedule cte 

targets:
  default:
    filesets: 
      - rtl

  sim : 
    flow : sim
    flow_options :
      tool : verilator 
      verilator_options : [-Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-SELRANGE]
      cocotb_module : speck_key_schedule_test
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl ,cocotb]  
    toplevel : key_schedule
    parameters :
      - N=16
      - M=4
      - T=22

parameters :
  N :
    datatype : int
    paramtype : vlogparam
  M :
    datatype : int
    paramtype : vlogparam
  T :
    datatype : int
    paramtype : vlogparam

filesets:
  cocotb :
    files :
      - block_ciphers/SPECK/cocotb_files/speck_key_schedule_test.py : {file_type : user, copyto : .}
      - block_ciphers/SPECK/python_code/speck.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils


  rtl:
    file_type: systemVerilogSource
    files: 
      - block_ciphers/SPECK/hdl_code/key_schedule.sv      
    depend:
      - counter
      - register

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master








