CAPI=2:

name : ::katan_round_function:0
description : katan round function 

targets:
  default:
    filesets: 
      - rtl

  sim : 
    flow : sim
    flow_options :
      tool : verilator 
      verilator_options : [-Wno-WIDTHEXPAND -Wno-WIDTHTRUNC -Wno-SELRANGE]
      cocotb_module : katan_round_function_test 
      timescale : 1ns/1ns
      vcs_options : [-timescale=1ns/1ns]
    filesets : [rtl ,cocotb]  
    toplevel : round_function
    parameters :
      - L1_LEN=13
      - L2_LEN=19

parameters :
  L1_LEN :
    datatype : int
    paramtype : vlogparam
  L2_LEN :
    datatype : int
    paramtype : vlogparam

filesets:
  cocotb :
    files :
      - block_ciphers/KATAN/cocotb_files/katan_round_function_test.py : {file_type : user, copyto : .}
      - block_ciphers/KATAN/python_code/katan.py : {file_type : user, copyto : .}
      - block_ciphers/KATAN/python_code/LFSR.py : {file_type : user, copyto : .}
    depend :
      - vlog_tb_utils


  rtl:
    file_type: systemVerilogSource
    files: 
      - block_ciphers/KATAN/hdl_code/round_function.sv

provider:
    name: github
    user: germancq
    repo: IPCores
    version: master







